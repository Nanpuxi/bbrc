{
  "name": "aarc-web",
  "private": "true",
  "version": "0.0.0",
  "type": "module",
  "author": {
    "name": "Au"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "vite",
    "dev-host": "vite --host",
    "prebuild": "node copy-license.mjs",
    "build": "node analyze-deps.mjs && tsx build.ts",
    "build-here": "node analyze-deps.mjs && tsx build.ts --here",
    "type-check": "tsx build.ts --check-only",
    "toggleEnvLocal": "tsx env/toggleLocalEnvFile.ts",
    "gitInfoGen": "tsx src/utils/gitInfo/gitInfoGen.ts",
    "syncClientArtifacts": "node sync-client-artifacts.mjs",
    "colorSetsGen": "tsx src/data/palette/colorSetsGen.ts",
    "test": "pnpm --filter aarc-core test",
    "test:run": "pnpm --filter aarc-core test:run"
  },
  "dependencies": {
    "@anilkumarthakur/vue3-json-viewer": "^0.6.0",
    "@aurouscia/au-color-picker": "^2.2.0",
    "@aurouscia/image-compress": "0.2.0",
    "@aurouscia/keyboard-shortcut": "^3.0.0",
    "@aurouscia/vite-app-version": "^1.1.0",
    "@microsoft/signalr": "^10.0.11",
    "aarc-core": "workspace:*",
    "axios": "^1.20.0",
    "copy-to-clipboard": "^4.0.2",
    "js-file-download": "^0.4.12",
    "lz-string": "^1.5.0",
    "pinia": "^4.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "rfdc": "^1.4.1",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@aurouscia/signalr-comment-fixer": "^1.0.0",
    "@types/node": "^26.4.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "archiver": "^8.0.0",
    "execa": "^9.6.1",
    "sass": "^1.103.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-full-reload": "^1.2.0",
    "vue-tsc": "^3.3.11"
  }
}