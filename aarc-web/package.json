{
  "name": "aarc-web",
  "private": "true",
  "version": "0.0.0",
  "type": "module",
  "author": {
    "name": "Au"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "vite",
    "dev-host": "vite --host",
    "build": "node analyze-deps.mjs && tsx build.ts",
    "build-here": "node analyze-deps.mjs && tsx build.ts --here",
    "type-check": "tsx build.ts --check-only",
    "toggleEnvLocal": "tsx env/toggleLocalEnvFile.ts",
    "gitInfoGen": "tsx src/utils/gitInfo/gitInfoGen.ts",
    "colorSetsGen": "tsx src/data/palette/colorSetsGen.ts",
    "test": "pnpm --filter aarc-core test",
    "test:run": "pnpm --filter aarc-core test:run"
  },
  "dependencies": {
    "aarc-core": "workspace:*",
    "@anilkumarthakur/vue3-json-viewer": "^0.4.1",
    "@aurouscia/au-color-picker": "^1.1.0",
    "@aurouscia/image-compress": "0.2.0",
    "@aurouscia/keyboard-shortcut": "^3.0.0",
    "@aurouscia/vite-app-version": "^0.2.0",
    "@microsoft/signalr": "^10.0.0",
    "axios": "^1.15.1",
    "copy-to-clipboard": "^3.3.3",
    "js-file-download": "^0.4.12",
    "lz-string": "^1.5.0",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "rfdc": "^1.4.1",
    "vue": "^3.5.32",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@aurouscia/signalr-comment-fixer": "^1.0.0",
    "@types/node": "^25.6.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "execa": "^9.6.1",
    "sass": "^1.99.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.1",
    "vite-plugin-full-reload": "^1.2.0",
    "vue-tsc": "^3.2.7"
  }
}